# Copy to .env (git-ignored) — read by ./run_web.sh and docker compose.
# STRUCTSYNC_TOKEN=change-me          # require this token on every API call (set before exposing beyond localhost)
# PORT=8000
# STRUCTSYNC_DATA=./data              # projects, uploads, renders, cache
# STRUCTSYNC_CATALOG=./catalog        # materials
# STRUCTSYNC_CACHE_MB=4096            # result cache cap, 0 = off
# STRUCTSYNC_SCENES=2                 # scenes kept loaded on the GPU
# STRUCTSYNC_PRELOAD=0                # 1 = load models at start-up
# STRUCTSYNC_LOG=INFO
# STRUCTSYNC_MAX_IMPORT_MB=2048
