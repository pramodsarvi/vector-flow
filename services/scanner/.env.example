# Copy to .env and edit. Every value is optional; the defaults run locally.

# Require this shared token on every API call. Set it before exposing the
# service beyond localhost — without it the API is open to anyone who can
# reach the port.
# SCANNER_TOKEN=change-me

# Where scans are stored (one directory per scan).
# SCANNER_DATA=./data

# Browser origins allowed to call the API. Empty = same-origin only, which is
# all the bundled viewer needs.
# SCANNER_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Largest accepted upload, in megabytes.
# SCANNER_MAX_UPLOAD_MB=512

# Scans kept on disk; the oldest finished ones are pruned past this.
# SCANNER_MAX_SCANS=50

# DEBUG | INFO | WARNING | ERROR
# SCANNER_LOG=INFO

# Port for ./run.sh
# PORT=8765
