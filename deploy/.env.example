# Copy to deploy/.env. Compose reads it automatically.

# Where the services listen. 0.0.0.0 publishes them on your network — set the
# matching token below before you do that.
# BIND=127.0.0.1

# SCANNER_PORT=8765
# SCANNER_TOKEN=change-me
# SCANNER_LOG=INFO
# SCANNER_MAX_UPLOAD_MB=512
# SCANNER_MAX_SCANS=50

# StructuralSync (only used with --profile gpu)
# STRUCTSYNC_PORT=8000
# STRUCTSYNC_TOKEN=change-me
